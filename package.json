{
  "name": "submania",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "models": "blender --background --python blender/build_models.py && node scripts/optimize-models.mjs",
    "optimize-models": "node scripts/optimize-models.mjs",
    "trailer": "node trailer/capture.mjs && node trailer/soundtrack.mjs",
    "icons": "blender --background --python blender/render_icons.py && uv run --with pillow scripts/optimize_images.py",
    "seagull": "blender --background ~/Developer/seagull/seagull.blend --python blender/import_seagull.py && node scripts/optimize-models.mjs seagull",
    "anglerfish": "blender --background ~/Developer/angler-fish/anglerfish.blend --python blender/import_anglerfish.py && node scripts/optimize-models.mjs anglerfish"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "peerjs": "^1.5.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  }
}
